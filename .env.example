# Where the SQLite database lives. Docker sets this to /data/ipod.db.
# DATABASE_PATH=./data/ipod.db

# Reserved for the future scheduled tweet importer (never commit real values).
# TWITTER_BEARER_TOKEN=

# Where the UGG Chronicles videos live (gitignored; populated by
# `npm run import:ugg`). In Docker, put them on the volume: /data/videos/ugg.
# VIDEOS_DIR=./data/videos/ugg
